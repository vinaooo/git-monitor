<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.vina.Painel" path="/io/github/vina/Painel/">
    <key name="repos" type="as"><default>[]</default><summary>Legacy flat repository list, only migrated into groups</summary></key>
    <key name="groups" type="a(sas)"><default>[]</default><summary>Repository groups: (name, repositories)</summary></key>
    <key name="layout" type="s"><choices><choice value="tabs"/><choice value="sidebar"/></choices><default>"sidebar"</default><summary>How groups are shown</summary></key>
    <key name="sort" type="s"><choices><choice value="manual"/><choice value="name"/><choice value="issues"/><choice value="prs"/><choice value="ci"/></choices><default>"manual"</default><summary>Card sort mode</summary></key>
    <key name="sort-reverse" type="b"><default>false</default><summary>Reverse the sort direction</summary></key>
    <key name="view" type="s"><choices><choice value="grid-small"/><choice value="grid-medium"/><choice value="grid-large"/><choice value="list"/></choices><default>"grid-medium"</default><summary>Card size / view mode</summary></key>
    <key name="titles" type="a{ss}"><default>{}</default><summary>Custom card titles by repository</summary></key>
    <key name="refresh-all-groups" type="b"><default>false</default><summary>Also refresh groups that are not in focus</summary></key>
    <key name="refresh-seconds" type="i"><range min="15" max="3600"/><default>60</default><summary>Auto refresh interval</summary></key>
  </schema>
</schemalist>
